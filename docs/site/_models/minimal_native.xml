<mujoco model="mujocable_minimal_native">
  <option timestep="0.0005" integrator="implicitfast"/>
  <extension><plugin plugin="mujoco.cable.unilateral"><instance name="rope">
    <config key="route_mode" value="native"/>
    <config key="stiffness" value="2000"/>
    <config key="damping" value="5"/>
    <config key="pretension_offset" value="0.000981"/>
  </instance></plugin></extension>
  <worldbody>
    <light pos="0 -1 2"/>
    <site name="start" pos="0 0 0.7" size="0.006"/>
    <geom type="plane" size="0.6 0.6 0.01"/>
    <body name="load" pos="0 0 0.25"><freejoint/>
      <geom type="box" size="0.02 0.02 0.02" mass="0.2"/>
      <site name="end" pos="0 0 0.02" size="0.006"/>
    </body>
  </worldbody>
  <tendon><spatial name="seed" width="0.002" rgba="1 0.35 0.05 1">
    <site site="start"/><site site="end"/>
  </spatial></tendon>
  <actuator><plugin name="pull" instance="rope" tendon="seed" gear="1"
                    ctrllimited="true" ctrlrange="0 0.06"/></actuator>
  <sensor><plugin name="rope_state" instance="rope"/></sensor>
</mujoco>
