<mujoco model="planar_four_bar_reference">
  <compiler angle="radian"/>
  <option timestep="0.001" gravity="0 0 0" integrator="implicitfast"/>
  <default>
    <joint type="hinge" axis="0 1 0" damping="0.02"/>
    <geom type="capsule" size="0.007" density="1000" contype="0" conaffinity="0"/>
    <site size="0.008" rgba="0.12 0.45 0.72 1"/>
  </default>
  <worldbody>
    <geom fromto="0 0 0.08 0.16 0 0.08" rgba="0.55 0.58 0.61 1"/>
    <body name="crank" pos="0 0 0.08">
      <joint name="crank_hinge"/>
      <geom fromto="0 0 0 0 0 0.10"/>
      <body name="coupler" pos="0 0 0.10">
        <joint name="coupler_hinge"/>
        <geom fromto="0 0 0 0.16 0 0"/>
        <site name="coupler_tip" pos="0.16 0 0"/>
      </body>
    </body>
    <body name="rocker" pos="0.16 0 0.08">
      <joint name="rocker_hinge"/>
      <geom fromto="0 0 0 0 0 0.10"/>
      <site name="rocker_tip" pos="0 0 0.10"/>
    </body>
  </worldbody>
  <equality>
    <connect name="close_loop" site1="coupler_tip" site2="rocker_tip"
             solref="0.01 1"/>
  </equality>
  <actuator>
    <position name="crank_target" joint="crank_hinge" kp="2" kv="0.1"
              ctrllimited="true" ctrlrange="-0.5 0.5"/>
  </actuator>
</mujoco>
