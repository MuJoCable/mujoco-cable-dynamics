<mujoco model="result_1_2_single_moving_pulley">
  <compiler autolimits="true" angle="radian" />
  <size nuser_site="1" />
  <option timestep="0.0005" gravity="0 0 -9.81" integrator="implicitfast" />
  <custom>
    <numeric name="pulley_radius_m" data="0.040" />
    <numeric name="payload_mass_kg" data="0.200" />
    <numeric name="moving_pulley_mass_kg" data="0.080" />
    <numeric name="ideal_mechanical_advantage" data="2" />
    <numeric name="ideal_fixed_to_moving_angle_ratio" data="2" />
    <numeric name="groove_root_radius_m" data="0.040" />
    <numeric name="groove_outer_radius_m" data="0.047" />
    <numeric name="groove_width_m" data="0.008" />
    <numeric name="pulley_total_width_m" data="0.018" />
    <numeric name="capstan_mu" data="0.12" />
  </custom>
  <extension>
    <plugin plugin="mujoco.cable.unilateral">
      <instance name="moving_pulley_cable">
        <config key="stiffness" value="4000" />
        <config key="damping" value="35" />
        <config key="slack" value="0.0001" />
        <config key="home_length" value="auto_initial" />
        <config key="pretension_offset" value="0.0008" />
        <config key="max_tension" value="80" />
        <config key="ctrl_mode" value="target_contraction" />
        <config key="route_mode" value="surface" />
        <config key="route_tendon" value="moving_pulley_seed" />
        <config key="wrap_geoms" value="moving_pulley_wrap upper_fixed_pulley_wrap" />
        <config key="site_role_user_index" value="0" />
        <config key="capstan_mu" value="0.12" />
        <config key="capstan_direction" value="velocity" />
        <config key="capstan_velocity_scale" value="0.01" />
        <config key="visual_width" value="2.4" />
      </instance>
    </plugin>
  </extension>
  <asset>
    <material name="frame_material" rgba="0.52 0.60 0.66 1" />
    <material name="pulley_material" rgba="0.72 0.75 0.78 0.38" />
    <material name="payload_material" rgba="0.08 0.36 0.88 1" />
  </asset>
  <default>
    <geom friction="0.7 0.03 0.005" />
    <site size="0.004" />
    <default class="route_hint"><site size="0.0001" rgba="1 0.8 0 0" user="2" /></default>
  </default>
  <worldbody>
    <light name="key" pos="-0.30 -0.85 0.80" dir="0.2 0.8 -0.7" />
    <camera name="overview" pos="0 -0.88 0.29" xyaxes="1 0 0 0 0 1" fovy="44" />
    <geom name="floor" type="plane" pos="0 0 -0.02" size="0.40 0.30 0.01" rgba="0.13 0.15 0.17 1" />
    <geom name="left_post" type="capsule" fromto="-0.24 0.04 -0.01 -0.24 0.04 0.50"
          size="0.007" material="frame_material" contype="0" conaffinity="0" />
    <geom name="top_beam" type="capsule" fromto="-0.25 0.04 0.50 0.18 0.04 0.50"
          size="0.007" material="frame_material" contype="0" conaffinity="0" />
    <site name="upper_fixed_end" pos="0.095 0 0.465" user="1"
          size="0.006" rgba="0.95 0.05 0.03 1" />
    <body name="upper_fixed_pulley" pos="-0.025 0 0.420">
      <joint name="upper_pulley_hinge" type="hinge" axis="0 1 0"
             damping="0.005" armature="0.0002" />
      <geom name="upper_fixed_pulley_wrap" type="cylinder"
            euler="1.57079632679 0 0" size="0.040 0.004" mass="0.080"
            material="pulley_material" contype="0" conaffinity="0" />
      <geom name="upper_pulley_front_flange" type="cylinder" pos="0 -0.0065 0"
            euler="1.57079632679 0 0" size="0.047 0.0025" density="0"
            material="pulley_material" contype="0" conaffinity="0" />
      <geom name="upper_pulley_rear_flange" type="cylinder" pos="0 0.0065 0"
            euler="1.57079632679 0 0" size="0.047 0.0025" density="0"
            material="pulley_material" contype="0" conaffinity="0" />
      <geom name="upper_radius_marker" type="capsule"
            fromto="0 -0.0095 0 0.034 -0.0095 0" size="0.0018"
            density="0" rgba="0.05 0.35 1 1" contype="0" conaffinity="0" />
      <!-- The upper pulley must use the upper branch: the cable arrives from
           the moving pulley and exits down the opposite side. -->
      <site name="upper_outer_hint" class="route_hint" pos="0 0 0.046" />
    </body>
    <site name="pulling_end" pos="-0.065 0 0.175" user="1"
          size="0.006" rgba="0.95 0.05 0.03 1" />
    <!-- The moving pulley and payload are separate top-level planar bodies. -->
    <body name="moving_pulley" pos="0.055 0 0.245">
      <joint name="moving_pulley_x" type="slide" axis="1 0 0" damping="0.05" />
      <joint name="moving_pulley_z" type="slide" axis="0 0 1" damping="0.05" />
      <joint name="moving_pulley_hinge" type="hinge" axis="0 1 0"
             damping="0.005" armature="0.0002" />
      <geom name="moving_pulley_wrap" type="cylinder"
            euler="1.57079632679 0 0" size="0.040 0.004" mass="0.080"
            material="pulley_material" contype="0" conaffinity="0" />
      <geom name="moving_pulley_front_flange" type="cylinder" pos="0 -0.0065 0"
            euler="1.57079632679 0 0" size="0.047 0.0025" density="0"
            material="pulley_material" contype="0" conaffinity="0" />
      <geom name="moving_pulley_rear_flange" type="cylinder" pos="0 0.0065 0"
            euler="1.57079632679 0 0" size="0.047 0.0025" density="0"
            material="pulley_material" contype="0" conaffinity="0" />
      <geom name="moving_radius_marker" type="capsule"
            fromto="0 -0.0095 0 0.034 -0.0095 0" size="0.0018"
            density="0" rgba="0.05 0.35 1 1" contype="0" conaffinity="0" />
      <site name="moving_lower_hint" class="route_hint" pos="0 0 -0.046" />
      <site name="pulley_load_tether_site" pos="0 0 -0.052"
            size="0.004" rgba="0.95 0.82 0.12 1" />
    </body>
    <body name="moving_load" pos="0.055 0 0.105">
      <joint name="moving_load_x" type="slide" axis="1 0 0" damping="0.05" />
      <joint name="moving_load_z" type="slide" axis="0 0 1" damping="0.05" />
      <joint name="moving_load_pitch" type="hinge" axis="0 1 0" damping="0.01" />
      <geom name="moving_load_geom" type="box"
            size="0.035 0.035 0.030" mass="0.200" material="payload_material" />
      <site name="load_tether_site" pos="0 0 0.038"
            size="0.004" rgba="0.95 0.82 0.12 1" />
    </body>
  </worldbody>
  <tendon>
    <spatial name="moving_pulley_seed" limited="false" width="0.000000001"
             rgba="1.0 0.25 0.04 1">
      <site site="upper_fixed_end" />
      <site site="moving_lower_hint" />
      <site site="upper_outer_hint" />
      <site site="pulling_end" />
    </spatial>
    <spatial name="pulley_load_tether" limited="false" width="0.003"
             rgba="0.95 0.82 0.12 1">
      <site site="pulley_load_tether_site" />
      <site site="load_tether_site" />
    </spatial>
  </tendon>
  <actuator>
    <plugin name="cable_contraction" tendon="moving_pulley_seed" gear="0"
            instance="moving_pulley_cable" ctrllimited="true" ctrlrange="0 0.140" />
  </actuator>
  <equality>
    <!-- With tendon2 omitted, MuJoCo fixes tendon1 to its initial length. -->
    <tendon name="pulley_load_inextensible"
            tendon1="pulley_load_tether" polycoef="0 1 0 0 0"
            solref="0.001 1" />
  </equality>
  <sensor>
    <plugin name="moving_pulley_cable_state" instance="moving_pulley_cable" />
    <framepos name="moving_pulley_position" objtype="body" objname="moving_pulley" />
    <framelinvel name="moving_pulley_velocity" objtype="body" objname="moving_pulley" />
    <framepos name="moving_load_position" objtype="body" objname="moving_load" />
    <framelinvel name="moving_load_velocity" objtype="body" objname="moving_load" />
    <jointpos name="upper_pulley_angle" joint="upper_pulley_hinge" />
    <jointvel name="upper_pulley_angular_velocity" joint="upper_pulley_hinge" />
    <jointpos name="moving_pulley_angle" joint="moving_pulley_hinge" />
    <jointvel name="moving_pulley_angular_velocity" joint="moving_pulley_hinge" />
    <tendonpos name="pulley_load_tether_length" tendon="pulley_load_tether" />
    <tendonvel name="pulley_load_tether_velocity" tendon="pulley_load_tether" />
  </sensor>
</mujoco>
