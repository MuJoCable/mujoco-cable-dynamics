        <config key="route_mode" value="surface" />
        <config key="route_tendon" value="atwood_seed" />
        <config key="wrap_geoms" value="atwood_pulley_wrap" />
        <config key="site_role_user_index" value="0" />
        <config key="capstan_mu" value="0.12" />
        <config key="capstan_direction" value="velocity" />
        <config key="capstan_velocity_scale" value="0.020" />
        <config key="visual_width" value="2.4" />
      </instance>
    </plugin>
  </extension>
  <asset>
    <material name="frame_material" rgba="0.52 0.60 0.66 1" />
    <material name="pulley_material" rgba="0.72 0.75 0.78 0.65" />
