  </option>
  <custom>
    <numeric name="pulley_radius_m" data="0.050" />
    <numeric name="pulley_mass_kg" data="0.080" />
    <numeric name="payload_density_kg_per_m3" data="1200" />
    <numeric name="left_box_half_size_m" data="0.023" />
    <numeric name="right_box_half_size_m" data="0.029" />
    <numeric name="bearing_damping_Nms_per_rad" data="0.005" />
    <numeric name="capstan_mu" data="0.12" />
